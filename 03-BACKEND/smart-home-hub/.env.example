# ============================================
# Smart Home Hub - Environment Variables
# State Store Architecture (No Database, No WebSocket)
# Copy file này thành .env và điền giá trị
# ============================================

# Flask
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production
PORT=5000
HOST=0.0.0.0

# MQTT Broker
# LOCAL  (Mosquitto): MQTT_TLS=false, PORT=1883
# CLOUD  (HiveMQ)   : MQTT_TLS=true,  PORT=8883, đổi BROKER/USER/PASSWORD
MQTT_TLS=false
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=smarthome
MQTT_PASSWORD=mqtt_password
MQTT_KEEPALIVE=60

# State Store (Optional Persistence)
STATE_STORE_PERSISTENCE=false
STATE_STORE_FILE=data/state_store.json

# API Polling
API_POLLING_INTERVAL=2000

# Notifications
NOTIFICATIONS_ENABLED=true
ALERT_TEMP_HIGH=35.0
ALERT_HUMIDITY_HIGH=80.0
ALERT_SOIL_DRY=30

# Cloud Sync (MQTT over TLS — HiveMQ Free / EMQX Cloud)
CLOUD_ENABLED=false
CLOUD_MQTT_BROKER=your-broker.hivemq.cloud
CLOUD_MQTT_PORT=8883
CLOUD_MQTT_USER=smarthome-hub
CLOUD_MQTT_PASSWORD=change-me
CLOUD_HUB_ID=smarthome-hub-001
