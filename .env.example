# ============================================================
# Docker Compose — Smart Home IoT
# Copy file này thành .env và điền giá trị thật
# ============================================================

# ─── Ports (nginx VPS proxy vào đây) ─────────────────────────
CLOUD_BE_PORT=3000
CLOUD_FE_PORT=5173
SMARTHUB_PORT=5001

# ─── Cloud BE ────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/smarthome

JWT_SECRET=replace-with-64-random-chars
REFRESH_TOKEN_SECRET=replace-with-another-64-random-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost,https://yourdomain.com
HUB_ID=smarthome-hub-001

# ─── Cloud MQTT (HiveMQ) — dùng chung cho BE + Hub ──────────
MQTT_BROKER_URL=mqtts://fded182921f94059b52bc084fc607d3b.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=smarthome
MQTT_PASSWORD=Smarthome123
MQTT_CLIENT_ID=cloud-be-server

# ─── Smart Hub ───────────────────────────────────────────────
SECRET_KEY=replace-with-random-secret-key
MQTT_BROKER=fded182921f94059b52bc084fc607d3b.s1.eu.hivemq.cloud
MQTT_USER=smarthome

CLOUD_MQTT_BROKER=fded182921f94059b52bc084fc607d3b.s1.eu.hivemq.cloud
CLOUD_MQTT_PORT=8883
CLOUD_MQTT_USER=smarthome
CLOUD_MQTT_PASSWORD=Smarthome123
CLOUD_HUB_ID=smarthome-hub-001

# ─── Cloud FE (build-time) ───────────────────────────────────
# Trỏ đến domain/IP VPS của cloud-be
VITE_API_URL=http://your-vps-ip:3000
VITE_SOCKET_URL=http://your-vps-ip:3000
