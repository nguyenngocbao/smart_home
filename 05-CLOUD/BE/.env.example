# ============================================
# Cloud BE — Environment Variables
# Copy sang .env và điền giá trị thật
# ============================================

# Server
PORT=3000
NODE_ENV=development

# MongoDB (Atlas hoặc local)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/smarthome

# JWT
JWT_SECRET=replace-with-64-random-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-another-64-random-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Cloud MQTT Broker (HiveMQ Free / EMQX Cloud)
MQTT_BROKER_URL=fded182921f94059b52bc084fc607d3b.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=smarthome
MQTT_PASSWORD=Smarthome123
MQTT_CLIENT_ID=cloud-be-server

# Hub
HUB_ID=smarthome-hub-001

# CORS (danh sách origin FE, phân cách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
